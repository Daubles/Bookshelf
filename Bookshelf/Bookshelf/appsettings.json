{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "BookCatalog": {
    "RefreshAfter": "30.00:00:00",
    "EditionsToFetch": 50,
    "MaxSaveAttempts": 2,
    "SearchLimit": 10
  },
  "AllowedHosts": "*"
}
