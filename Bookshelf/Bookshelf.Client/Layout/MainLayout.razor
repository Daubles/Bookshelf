@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider Theme="_bookshelfTheme" IsDarkMode="true"/>
<MudPopoverProvider />

<MudLayout>
    <MudAppBar>
        <MudText Class="brand-title" Typo="Typo.h5">Bookshelf</MudText>
        <MudSpacer />
        <div class="nav-search">
            <MudTextField @bind-Value="_searchString" Immediate="true" OnKeyDown="OnSearchKeyDown" Placeholder="Search books" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="SearchBook" IconSize="Size.Small" Variant="Variant.Filled"
                          Margin="Margin.Dense" />
        </div>
        <AuthorizeView>
            <Authorized>
                <LogoutButton />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/register">Create Account</MudButton>
                <MudButton Href="/login">Log In</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private readonly MudTheme _bookshelfTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#6495ED"
        }
    };

    private string? _searchString;

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SearchBook();
    }

    private void SearchBook()
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return;

        Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(_searchString.Trim())}");
    }
}
