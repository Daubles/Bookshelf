@inherits LayoutComponentBase

<MudThemeProvider Theme="_bookshelfTheme" IsDarkMode="true"/>
<MudPopoverProvider />

<MudLayout>
    <MudAppBar>
        <MudText Class="brand-title">Bookshelf</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <LogoutButton />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/register">Create Account</MudButton>
                <MudButton Href="/login">Log In</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private readonly MudTheme _bookshelfTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#6495ED"
        }
    };
}
