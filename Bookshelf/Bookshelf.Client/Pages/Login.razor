@page "/login"
@inject HttpClient Http
@inject NavigationManager Nav

<MudText HtmlTag="h1" Class="form-header mt-16">Log in</MudText>
<MudContainer Class="mt-4" MaxWidth="MaxWidth.ExtraSmall">
        <MudForm @ref="_form" Model="_model">
            <MudStack Spacing="2">
                <MudTextField Label="Email" Variant="Variant.Outlined" @bind-Value="_model.Email" For="() => _model.Email" InputType="InputType.Email" />
                <MudTextField Label="Password" Variant="Variant.Outlined" @bind-Value="_model.Password" For="() => _model.Password" InputType="_password.InputType" 
                              Adornment="Adornment.End" AdornmentIcon="@_password.Icon" OnAdornmentClick="_password.Toggle" AdornmentAriaLabel="Show Password"/>
                <MudCheckBox @bind-Value="_model.RememberMe">Remember me</MudCheckBox>
                @foreach (var e in _errors)
                {
                    <MudAlert Class="my-2" Severity="Severity.Error" Dense="true">@e</MudAlert>
                }
                <MudButton Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" OnClick="@(async () => await SubmitAsync())"
                           Disabled="_submitting">Log in</MudButton>
            </MudStack>
        </MudForm>
        <MudText Class="mt-8" Align="Align.Center">New to Bookshelf?</MudText>
        <MudButton Size="Size.Large" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Href="/register">Sign up</MudButton>
</MudContainer>

@code {
    private readonly LoginUserRequest _model = new();

    private string[] _errors = [];
    private bool _submitting;
    private MudForm _form = null!;

    private readonly PasswordVisibility _password = new();

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _submitting = true;
        _errors = [];

        try
        {
            var result = await Http.PostAsJsonAsync("api/auth/login", new { _model.Email, _model.Password, _model.RememberMe });

            if (result.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/", forceLoad: true);
                return;
            }

            if (result.StatusCode == HttpStatusCode.BadRequest)
            {
                var errors = await ProblemErrors.ReadAsync(result);
                _errors = errors.Length > 0 ? errors : ["Please check your email and password and try again."];
                return;
            }

            _errors = result.StatusCode switch
            {
                HttpStatusCode.Unauthorized => ["Invalid email or password."],
                HttpStatusCode.TooManyRequests => ["Too many failed login attempts. Your account is locked, please try again later."],
                _ => ["Something went wrong on our end. Please try again."]
            };
        }
        catch (HttpRequestException)
        {
            _errors = ["We couldn't process your request. Please check your connection and try again."];
        }
        finally
        {
            _submitting = false;
        }
    }
}
